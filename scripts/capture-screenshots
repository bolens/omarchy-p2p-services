#!/usr/bin/env bash
set -Eeuo pipefail
trap 'printf "Capture failed at line %s.\n" "$LINENO" >&2' ERR

plugin_id="io.github.bolens.p2p-services"
monitor=""
capture_workspace=""
verify_only=false
report_file=""
panel_width=600
audit_dir=""
side_padding=16
panel_height=600

usage() {
  cat <<'EOF'
Usage: scripts/capture-screenshots [--monitor NAME] [--workspace ID] [--panel-width PX] [--audit-dir DIR] [--verify] [--report FILE]

Capture privacy-filtered live plugin examples on an empty workspace. The
workflow forces and verifies privacy filtering before capture, strips image
metadata, and restores settings and the original workspace afterward. Audit
mode retains settings-page top, bottom, and conditional-state evidence without
publishing it to the documentation gallery.
EOF
}

while (($#)); do
  case "$1" in
    --monitor) monitor=${2:-}; shift 2 ;;
    --workspace) capture_workspace=${2:-}; shift 2 ;;
    --panel-width) panel_width=${2:-}; shift 2 ;;
    --audit-dir) audit_dir=${2:-}; shift 2 ;;
    --verify) verify_only=true; shift ;;
    --report) report_file=${2:-}; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ ! $panel_width =~ ^[0-9]+$ ]] || ((panel_width < 420 || panel_width > 800)); then
  printf 'Panel width must be an integer from 420 through 800.\n' >&2
  exit 2
fi
if [[ -n $audit_dir ]]; then
  [[ $audit_dir == /tmp/* ]] || { printf 'Audit output must be below /tmp.\n' >&2; exit 2; }
  verify_only=true
fi

for command in qs hyprctl jq grim magick pngquant flock python3 ps; do
  command -v "$command" >/dev/null || { printf 'Missing required command: %s\n' "$command" >&2; exit 1; }
done

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
runtime_fingerprint=$(scripts/capture-plugin-fingerprint "$repo_root")
lock_file="${XDG_RUNTIME_DIR:-/tmp}/p2p-services-screenshots-${UID}.lock"
exec 9>"$lock_file"
flock -n 9 || { printf 'Another P2P screenshot capture is running.\n' >&2; exit 1; }

monitor_json=$(hyprctl monitors -j)
cursor_json=$(hyprctl cursorpos -j)
active_window_json=$(hyprctl activewindow -j)
if [[ -z $monitor ]]; then
  client_json=$(hyprctl clients -j)
  launcher_pids=()
  launcher_pid=$PPID
  while [[ $launcher_pid =~ ^[1-9][0-9]*$ ]] && ((launcher_pid > 1)); do
    launcher_pids+=("$launcher_pid")
    launcher_pid=$(ps -o ppid= -p "$launcher_pid" 2>/dev/null | tr -d ' ')
  done
  launcher_pid_json=$(printf '%s\n' "${launcher_pids[@]}" | jq -s 'map(select(length > 0) | tonumber)')
  launcher_monitor=$(jq -r --argjson pids "$launcher_pid_json" '[ $pids[] as $pid | .[] | select(.pid == $pid) | .monitor ][0] // -1' <<<"$client_json")
  monitor_state=$(jq -cn --argjson launcher "$launcher_monitor" --argjson active "$active_window_json" --argjson monitors "$monitor_json" --argjson cursor "$cursor_json" '{launcher:{monitor:$launcher},active:$active,monitors:$monitors,cursor:$cursor}')
  monitor=$(scripts/select-capture-monitor "$monitor_state") || { printf 'Could not determine the launch monitor; pass --monitor NAME.\n' >&2; exit 2; }
fi
[[ $monitor =~ ^[A-Za-z0-9_.-]+$ ]] || { printf 'Invalid monitor name: %s\n' "$monitor" >&2; exit 2; }
monitor_width=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .width' <<<"$monitor_json")
monitor_height=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .height' <<<"$monitor_json")
monitor_x=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .x' <<<"$monitor_json")
monitor_y=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .y' <<<"$monitor_json")
original_workspace=$(jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .activeWorkspace.id' <<<"$monitor_json")
original_cursor_x=$(jq -r '.x' <<<"$cursor_json")
original_cursor_y=$(jq -r '.y' <<<"$cursor_json")
[[ $monitor_width =~ ^[1-9][0-9]*$ && $monitor_height =~ ^[1-9][0-9]*$ && $monitor_x =~ ^-?[0-9]+$ && $monitor_y =~ ^-?[0-9]+$ && $original_cursor_x =~ ^-?[0-9]+$ && $original_cursor_y =~ ^-?[0-9]+$ && $original_workspace =~ ^-?[0-9]+$ ]] || { printf 'Monitor is not active: %s\n' "$monitor" >&2; exit 2; }

if [[ -z $capture_workspace ]]; then
  capture_workspace=$(jq -r --arg monitor "$monitor" '[.[] | select(.monitor == $monitor and .id > 0 and .windows == 0) | .id] | sort | reverse | .[0] // empty' < <(hyprctl workspaces -j))
fi
[[ $capture_workspace =~ ^[1-9][0-9]*$ ]] || { printf 'Choose an empty positive workspace with --workspace.\n' >&2; exit 2; }
window_count=$(jq -r --argjson workspace "$capture_workspace" '[.[] | select(.workspace.id == $workspace)] | length' < <(hyprctl clients -j))
((window_count == 0)) || { printf 'Workspace %s is not empty.\n' "$capture_workspace" >&2; exit 2; }

capture_dir=$(mktemp -d)
settings_file="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/p2p-services"
durable_file="$state_dir/settings.json"
previous_file="$state_dir/settings.previous.json"
install -m 0600 "$settings_file" "$capture_dir/shell.json"
[[ -f $durable_file ]] && install -m 0600 "$durable_file" "$capture_dir/settings.json"
[[ -f $previous_file ]] && install -m 0600 "$previous_file" "$capture_dir/settings.previous.json"
restored=false
shell_pid=""
initial_shell_pid=""

check_capture_environment() {
  [[ -n $initial_shell_pid ]] || return 0
  scripts/capture-environment-guard "$initial_shell_pid" "$repo_root" "$runtime_fingerprint"
}

wait_for_shell() {
  local candidate reply capture_contract
  for _attempt in {1..80}; do
    while read -r candidate; do
      [[ $candidate =~ ^[1-9][0-9]*$ ]] || continue
      reply=$(qs ipc --pid "$candidate" call shell ping 2>/dev/null || true)
      capture_contract=$(qs ipc --pid "$candidate" call "$plugin_id" captureContract 2>/dev/null || true)
      if [[ $reply == ok && $capture_contract == 2 ]]; then shell_pid=$candidate; return 0; fi
    done < <(qs list --all | awk '/Process ID:/ { print $3 }' | sort -rn)
    sleep .25
  done
  printf 'Omarchy Shell did not expose P2P capture contract 2.\n' >&2
  return 1
}

reload_live_settings() {
  local expected=$1 snapshot
  wait_for_shell
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" reloadSettings 2>/dev/null || true) == ok ]] || return 1
  for _attempt in {1..80}; do
    snapshot=$(qs ipc --pid "$shell_pid" call "$plugin_id" settingsSnapshot 2>/dev/null || true)
    jq -e "$expected" <<<"${snapshot:-null}" >/dev/null 2>&1 && return 0
    sleep .25
  done
  return 1
}

wait_plugin_state() {
  local method=$1 expected=$2; shift 2
  for _attempt in {1..80}; do
    [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" "$method" "$@" 2>/dev/null || true) == "$expected" ]] && return 0
    sleep .25
  done
  return 1
}

open_settings_page() {
  local page=$1 reply
  for _attempt in {1..20}; do
    focus_capture_workspace
    reply=$(qs ipc --pid "$shell_pid" call "$plugin_id" openSettings "$page" 2>/dev/null || true)
    if [[ $reply == ok ]]; then
      for _ready_attempt in {1..40}; do
        [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" settingsReady "$page" 2>/dev/null || true) == true ]] && return 0
        sleep .25
      done
    fi
    wait_for_shell >/dev/null 2>&1 || true
    sleep .25
  done
  printf 'Could not open %s settings.\n' "$page" >&2
  return 1
}

focus_capture_workspace() {
  local focused
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $((monitor_x + monitor_width / 2)), y = $((monitor_y + monitor_height / 2)) }))" >/dev/null
  for _attempt in {1..20}; do
    focused=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .focused')
    [[ $focused == true ]] && break
    sleep .1
  done
  [[ $focused == true ]] || { printf 'Could not focus capture monitor %s.\n' "$monitor" >&2; return 1; }
  hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = \"$capture_workspace\" }))" >/dev/null
  for _attempt in {1..30}; do
    state=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | "\(.focused) \(.activeWorkspace.id)"')
    [[ $state == "true $capture_workspace" ]] && return 0
    sleep .1
  done
  return 1
}

park_capture_cursor() {
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $((monitor_x + monitor_width / 2)), y = $((monitor_y + monitor_height / 2)) }))" >/dev/null
}

restore_cursor() {
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $original_cursor_x, y = $original_cursor_y }))" >/dev/null 2>&1
}

restore_desktop() {
  local status=$?
  if [[ $restored == false ]]; then
    if [[ -n $shell_pid ]]; then
      qs ipc --pid "$shell_pid" call shell hide "$plugin_id" >/dev/null 2>&1 || true
    fi
    restore_file() {
      local source=$1 destination=$2 temporary_restore
      temporary_restore=$(mktemp "${destination}.XXXXXX")
      install -m 0600 "$source" "$temporary_restore"
      mv -- "$temporary_restore" "$destination"
    }
    restore_file "$capture_dir/shell.json" "$settings_file"
    if [[ -f $capture_dir/settings.json ]]; then restore_file "$capture_dir/settings.json" "$durable_file"; else rm -f -- "$durable_file"; fi
    if [[ -f $capture_dir/settings.previous.json ]]; then restore_file "$capture_dir/settings.previous.json" "$previous_file"; else rm -f -- "$previous_file"; fi
    hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $((monitor_x + monitor_width / 2)), y = $((monitor_y + monitor_height / 2)) }))" >/dev/null 2>&1 || true
    hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = \"$original_workspace\" }))" >/dev/null 2>&1 || true
    for _restore_attempt in {1..30}; do
      restored_workspace=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .activeWorkspace.id')
      [[ $restored_workspace == "$original_workspace" ]] && break
      sleep .1
    done
    restore_cursor || true
    reload_live_settings 'type == "object"' >/dev/null 2>&1 || true
    restored=true
  fi
  return "$status"
}
cleanup_capture() {
  local status=$?
  restore_desktop || true
  rm -rf -- "$capture_dir"
  return "$status"
}
trap cleanup_capture EXIT INT TERM

# Durable settings win reconciliation and are pushed reactively to every live
# monitor instance; no Quickshell restart is needed for capture-time swaps.
./p2p-control settings-patch "{\"privacyFilter\":true,\"popupWidth\":$panel_width,\"showStopped\":true,\"serviceLayout\":\"list\",\"cardDensity\":\"comfortable\",\"serviceGroupMode\":\"category\",\"showBackendBadge\":true,\"serviceSortMode\":\"name\",\"serviceSortDirection\":\"automatic\"}" >/dev/null
reload_live_settings ".privacyFilter == true and .popupWidth == $panel_width and .serviceLayout == \"list\" and .cardDensity == \"comfortable\""
initial_shell_pid=$shell_pid
check_capture_environment

[[ $(./p2p-control settings-load | jq -r '.privacyFilter') == true ]] || { printf 'Durable privacy filter verification failed.\n' >&2; exit 1; }
shell_config=$(qs ipc --pid "$shell_pid" call shell listShellConfig)
[[ $(jq -r --arg id "$plugin_id" '.. | objects | select(.id? == $id) | .privacyFilter' <<<"$shell_config") == true ]] || { printf 'Shell privacy filter verification failed.\n' >&2; exit 1; }
./p2p-control status private "" no-stats | jq -e '
  type == "object" and (.services | type == "array") and
  all(.services[];
    .privacyFiltered == true and (.pids | length == 0) and
    (.endpoints | length == 0) and (.web == "" or .web == "Available") and
    (.proxy == "" or .proxy == "caddy") and
    (.config == "" or .config == "Hidden"))
' >/dev/null

focus_capture_workspace
park_capture_cursor
[[ $(qs ipc --pid "$shell_pid" call "$plugin_id" open) == ok ]]
wait_plugin_state mainReady true list comfortable
widget_x=""
widget_width=""
for _attempt in {1..40}; do
  geometry=$(qs ipc --pid "$shell_pid" call shell debugBarGeometry 2>/dev/null || true)
  widget_row=$(jq -c --arg id "$plugin_id" --argjson width "$monitor_width" '[range(0; length) as $index | select(.[$index].id == "omarchy.clock") | $index] as $starts | [$starts[] as $start | ($starts | index($start)) as $position | ($starts[$position + 1] // length) as $end | .[$start:$end] as $group | ($group | map(select(.id == $id and .visible and .width > 0)) | .[0]) as $widget | select($widget != null) | $widget + {_monitorExtent: ($group | map(.x + .width) | max)}] | sort_by(((._monitorExtent - $width) | fabs)) | .[0]' <<<"${geometry:-[]}" 2>/dev/null || true)
  widget_x=$(jq -r '.x // empty' <<<"${widget_row:-null}")
  widget_width=$(jq -r '.width // empty' <<<"${widget_row:-null}")
  [[ $widget_x =~ ^[0-9]+$ && $widget_width =~ ^[1-9][0-9]*$ ]] && break
  sleep .25
done
[[ $widget_x =~ ^[0-9]+$ && $widget_width =~ ^[1-9][0-9]*$ ]] || { printf 'Could not resolve P2P bar geometry.\n' >&2; exit 1; }
crop_width=$((panel_width + side_padding * 2))
panel_x=$((widget_x + widget_width / 2 - crop_width / 2))
((panel_x < 0)) && panel_x=0
((panel_x + crop_width <= monitor_width)) || panel_x=$((monitor_width - crop_width))

refresh_capture_geometry() {
  local geometry row current_x current_width
  geometry=$(qs ipc --pid "$shell_pid" call shell debugBarGeometry 2>/dev/null || true)
  row=$(jq -c --arg id "$plugin_id" --argjson width "$monitor_width" '[range(0; length) as $index | select(.[$index].id == "omarchy.clock") | $index] as $starts | [$starts[] as $start | ($starts | index($start)) as $position | ($starts[$position + 1] // length) as $end | .[$start:$end] as $group | ($group | map(select(.id == $id and .visible and .width > 0)) | .[0]) as $widget | select($widget != null) | $widget + {_monitorExtent: ($group | map(.x + .width) | max)}] | sort_by(((._monitorExtent - $width) | fabs)) | .[0]' <<<"${geometry:-[]}" 2>/dev/null || true)
  current_x=$(jq -r '.x // empty' <<<"${row:-null}")
  current_width=$(jq -r '.width // empty' <<<"${row:-null}")
  [[ $current_x =~ ^[0-9]+$ && $current_width =~ ^[1-9][0-9]*$ ]] || return 1
  widget_x=$current_x
  widget_width=$current_width
  panel_x=$((widget_x + widget_width / 2 - crop_width / 2))
  ((panel_x < 0)) && panel_x=0
  ((panel_x + crop_width <= monitor_width)) || panel_x=$((monitor_width - crop_width))
}

wait_for_capture_geometry() {
  local previous="" current="" stable=0
  for _geometry_attempt in {1..40}; do
    refresh_capture_geometry || { sleep .1; continue; }
    current="$widget_x:$widget_width"
    if [[ $current == "$previous" ]]; then
      stable=$((stable + 1))
      ((stable >= 2)) && return 0
    else
      stable=0
      previous=$current
    fi
    sleep .1
  done
  printf 'Bar geometry did not settle for capture.\n' >&2
  return 1
}

capture_panel() {
  local name=$1
  local height=${2:-$panel_height}
  local distinct_from=${3:-}
  local colors
  for _attempt in {1..4}; do
    check_capture_environment
    focus_capture_workspace
    refresh_capture_geometry || { sleep .25; continue; }
    # IPC readiness confirms QML state, not compositor presentation. Let the
    # selected panel frame settle before retaining visual evidence.
    sleep .3
    grim -o "$monitor" "$capture_dir/$name-full.png"
    magick "$capture_dir/$name-full.png" -crop "${crop_width}x${height}+${panel_x}+20" +repage "$capture_dir/$name.png"
    colors=$(magick "$capture_dir/$name.png" -format '%k' info: 2>/dev/null || true)
    if [[ $colors =~ ^[0-9]+$ ]] && ((colors >= 8)); then
      if [[ -z $distinct_from ]] || ! magick compare -metric AE "$capture_dir/$distinct_from.png" "$capture_dir/$name.png" null: >/dev/null 2>&1; then return 0; fi
    fi
    sleep .5
  done
  printf 'Could not capture populated %s view.\n' "$name" >&2
  return 1
}

capture_audit_bar() {
  local name=$1 colors
  focus_capture_workspace
  wait_for_capture_geometry
  grim -o "$monitor" "$capture_dir/$name-full.png"
  magick "$capture_dir/$name-full.png" -crop "${widget_width}x50+${widget_x}+0" +repage "$capture_dir/$name.png"
  colors=$(magick "$capture_dir/$name.png" -format '%k' info: 2>/dev/null || true)
  if [[ ! $colors =~ ^[0-9]+$ ]] || ((colors < 2)); then
    printf 'Could not capture populated %s bar view.\n' "$name" >&2
    return 1
  fi
}

open_main_view() {
  local layout=${1:-list} density=${2:-comfortable}
  for _attempt in {1..20}; do
    if [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" open 2>/dev/null || true) == ok ]] \
      && wait_plugin_state mainReady true "$layout" "$density"; then return 0; fi
    sleep .25
  done
  printf 'Could not open the main service view.\n' >&2
  return 1
}

open_service_details() {
  local service_id=$1
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" openDetails "$service_id" 2>/dev/null || true) == ok ]] || return 1
  wait_plugin_state detailsReady true "$service_id" || { printf 'Could not expand %s details.\n' "$service_id" >&2; return 1; }
}

open_service_editor() {
  local service_id=$1
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" openEditor "$service_id" 2>/dev/null || true) == ok ]] || return 1
  wait_plugin_state editorReady true "$service_id" || { printf 'Could not open %s editor.\n' "$service_id" >&2; return 1; }
}

close_panel() {
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" close 2>/dev/null || true) == ok ]] || return 1
  wait_plugin_state panelClosed true
}

open_main_view
capture_panel panel
if [[ -n $audit_dir ]]; then install -m 0644 "$capture_dir/panel.png" "$capture_dir/audit-main.png"; fi
[[ $(qs ipc --pid "$shell_pid" call "$plugin_id" privacyEnabled) == true ]] || { printf 'Live widget privacy verification failed.\n' >&2; exit 1; }
open_service_details i2p
capture_panel details "$panel_height" panel
open_service_editor i2p
capture_panel editor
open_main_view list comfortable
for page in general appearance services performance discovery packages; do
  open_settings_page "$page"
  if [[ $page == packages ]]; then capture_panel "$page" 400; else capture_panel "$page"; fi
  if [[ -n $audit_dir ]]; then
    [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" scrollSettings top 2>/dev/null || true) == ok ]]
    capture_panel "audit-${page}-top"
    [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" scrollSettings bottom 2>/dev/null || true) == ok ]]
    capture_panel "audit-${page}-bottom"
  fi
done

if [[ -n $audit_dir ]]; then
  ./p2p-control settings-patch '{"loadingIndicatorStyle":"glyph"}' >/dev/null
  reload_live_settings '.loadingIndicatorStyle == "glyph"'
  open_settings_page appearance
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" scrollSettings top 2>/dev/null || true) == ok ]]
  capture_panel audit-appearance-conditional-top
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" scrollSettings bottom 2>/dev/null || true) == ok ]]
  capture_panel audit-appearance-conditional-bottom

  ./p2p-control settings-patch '{"serviceGroupMode":"none"}' >/dev/null
  reload_live_settings '.serviceGroupMode == "none"'
  open_settings_page services
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" scrollSettings top 2>/dev/null || true) == ok ]]
  capture_panel audit-services-ungrouped-top
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" scrollSettings bottom 2>/dev/null || true) == ok ]]
  capture_panel audit-services-ungrouped-bottom

  ./p2p-control settings-patch '{"barPresentation":"category-active-total","hideZeroCount":false}' >/dev/null
  reload_live_settings '.barPresentation == "category-active-total" and .hideZeroCount == false'
  close_panel
  capture_audit_bar audit-bar-category-active-total

  ./p2p-control settings-patch '{"barPresentation":"category-active","hideZeroCount":true}' >/dev/null
  reload_live_settings '.barPresentation == "category-active" and .hideZeroCount == true'
  capture_audit_bar audit-bar-category-active-nonzero

  check_capture_environment
  mkdir -p "$audit_dir"
  for image in "$capture_dir"/audit-*.png; do
    [[ $image == *-full.png ]] && continue
    output="$audit_dir/${image##*/}"
    magick "$image" -strip -define png:compression-level=9 "$output"
  done
  restore_desktop
  wait_for_shell
  scripts/verify-capture-postconditions "$capture_dir" "$settings_file" "$durable_file" "$previous_file" "$monitor" "$original_workspace" "$initial_shell_pid" "$shell_pid"
  rm -rf -- "$capture_dir"
  trap - EXIT INT TERM
  if [[ -n $report_file ]]; then
    mkdir -p "$(dirname "$report_file")"
    jq -n --argjson shellPid "$shell_pid" --arg monitor "$monitor" --argjson captureWorkspace "$capture_workspace" \
      --argjson restoredWorkspace "$original_workspace" \
      '{version:1,result:"passed",verified:true,published:false,audit:true,privacyFilter:true,shellPid:$shellPid,monitor:$monitor,captureWorkspace:$captureWorkspace,restoredWorkspace:$restoredWorkspace}' >"$report_file"
  fi
  printf 'Retained privacy-filtered settings audit from %s workspace %s; restored workspace %s.\n' "$monitor" "$capture_workspace" "$original_workspace"
  exit 0
fi

capture_layout() {
  local name=$1 layout=$2 density=$3
  ./p2p-control settings-patch "{\"privacyFilter\":true,\"showStopped\":true,\"serviceLayout\":\"$layout\",\"cardDensity\":\"$density\",\"serviceGroupMode\":\"none\",\"showBackendBadge\":true}" >/dev/null
  reload_live_settings ".privacyFilter == true and .serviceLayout == \"$layout\" and .cardDensity == \"$density\""
  focus_capture_workspace
  [[ $(qs ipc --pid "$shell_pid" call "$plugin_id" privacyEnabled) == true ]] || { printf 'Live widget privacy verification failed for %s.\n' "$name" >&2; return 1; }
  open_main_view "$layout" "$density"
  capture_panel "$name"
}
capture_layout compact list compact
capture_layout grid grid compact
close_panel
check_capture_environment
grim -o "$monitor" "$capture_dir/bar-full.png"
magick "$capture_dir/bar-full.png" -crop "${widget_width}x50+${widget_x}+0" +repage "$capture_dir/bar.png"

stage="$capture_dir/stage"
mkdir -p "$stage/docs"
assets=()
validate_capture() {
  local image=$1 expected_width=$2 expected_height=$3 actual
  actual=$(magick identify -format '%wx%h' "$image")
  [[ $actual == "${expected_width}x${expected_height}" ]] || {
    printf 'Capture dimensions do not match: %s expected=%sx%s actual=%s\n' "$image" "$expected_width" "$expected_height" "$actual" >&2
    exit 1
  }
}
for image in panel details editor compact grid general appearance services performance discovery packages bar; do
  colors=$(magick "$capture_dir/$image.png" -format '%k' info:)
  if [[ ! $colors =~ ^[0-9]+$ ]] || ((colors < 8)); then
    printf 'Capture has too little content: %s\n' "$image" >&2
    exit 1
  fi
  magick "$capture_dir/$image.png" -strip -define png:compression-level=9 "$stage/docs/$image.png"
  pngquant --force --quality=82-95 --speed 1 --strip --output "$stage/docs/$image.png" "$stage/docs/$image.png"
  assets+=("docs/$image.png")
done
for image in panel details editor compact grid general appearance services performance discovery; do validate_capture "$stage/docs/$image.png" "$crop_width" "$panel_height"; done
validate_capture "$stage/docs/packages.png" "$crop_width" 400
validate_capture "$stage/docs/bar.png" "$widget_width" 50
declare -A capture_digests=()
for image in panel details editor compact grid general appearance services performance discovery packages bar; do
  digest=$(sha256sum "$stage/docs/$image.png" | awk '{print $1}')
  if [[ -n ${capture_digests[$digest]:-} ]]; then
    printf 'Duplicate captures: %s and %s\n' "${capture_digests[$digest]}" "$image" >&2
    exit 1
  fi
  capture_digests[$digest]=$image
done
install -m 0644 "$stage/docs/panel.png" "$stage/docs/preview.png"
install -m 0644 "$stage/docs/panel.png" "$stage/preview.png"
magick -size 1200x630 xc:'#08111f' \
  -fill '#0d1b2d' -stroke '#203b55' -strokewidth 2 -draw 'roundrectangle 42,42 1158,588 28,28' \
  \( "$stage/docs/panel.png" -resize '500x500>' \) -gravity east -geometry +82+0 -composite \
  -gravity northwest -stroke none -font DejaVu-Sans-Bold -fill '#55d6ff' -pointsize 28 -annotate +92+132 'OMARCHY SHELL PLUGIN' \
  -fill '#e8f4ff' -pointsize 70 -annotate +88+204 'P2P Services' \
  -font DejaVu-Sans -fill '#91a8bd' -pointsize 30 -interline-spacing 10 -annotate +92+308 'Your peers.\nOne surface.' \
  -fill '#69e6a6' -pointsize 23 -annotate +92+472 'Private by default  •  30+ services' \
  -strip -define png:compression-level=9 "$stage/docs/social-card.png"
pngquant --force --quality=82-95 --speed 1 --strip --output "$stage/docs/social-card.png" "$stage/docs/social-card.png"
assets+=(docs/preview.png docs/social-card.png preview.png)
check_capture_environment
if [[ $verify_only == false ]]; then
  install -m 0644 docs/index.html "$stage/docs/index.html"
  install -m 0644 README.md "$stage/README.md"
  scripts/update-screenshot-metadata "$stage/docs/index.html" "$stage/docs" "$stage/README.md"
  assets+=(docs/index.html README.md)
fi

restore_desktop
wait_for_shell
scripts/verify-capture-postconditions "$capture_dir" "$settings_file" "$durable_file" "$previous_file" "$monitor" "$original_workspace" "$initial_shell_pid" "$shell_pid"
if [[ $verify_only == false ]]; then
  check_capture_environment
  scripts/publish-screenshot-assets "$stage" "${assets[@]}"
fi
rm -rf -- "$capture_dir"
trap - EXIT INT TERM
if [[ -n $report_file ]]; then
  mkdir -p "$(dirname "$report_file")"
  jq -n --argjson published "$([[ $verify_only == false ]] && printf true || printf false)" \
    --argjson shellPid "$shell_pid" --arg monitor "$monitor" --argjson captureWorkspace "$capture_workspace" \
    --argjson restoredWorkspace "$original_workspace" \
    '{version:1,result:"passed",verified:true,published:$published,privacyFilter:true,shellPid:$shellPid,monitor:$monitor,captureWorkspace:$captureWorkspace,restoredWorkspace:$restoredWorkspace}' >"$report_file"
fi
printf 'Updated privacy-filtered screenshots from %s workspace %s; restored workspace %s.\n' "$monitor" "$capture_workspace" "$original_workspace"
