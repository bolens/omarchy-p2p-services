def watch_event_payload(kind="heartbeat",healthy=True,code="ok",lifecycle=None):
  payload={"type":"watch-event","version":1,"kind":kind,"healthy":healthy,"code":str(code)[:64],"timestampMs":int(time.time()*1000)}
  if lifecycle:
    payload.update(serviceId=lifecycle["serviceId"],lifecycleKind=lifecycle["kind"],lifecycleCause=lifecycle["cause"])
  return payload

def watch_events():
  commands=[]
  busctl=shutil.which("busctl")
  if busctl: commands.append(("systemd",[os.path.realpath(busctl),"monitor","org.freedesktop.systemd1"]))
  # Podman's events command polls its database continuously and can consume a
  # full CPU core while idle. Status reconciliation already provides bounded
  # Podman change detection, so only Docker gets a persistent event stream.
  for runtime in ("docker",):
    command=shutil.which(runtime)
    if command: commands.append((runtime,[os.path.realpath(command),"events","--filter","type=container","--format","{{json .}}"] ))
  processes=[]; sources={}; selector=selectors.DefaultSelector()
  def stop_watching(_signum, _frame): raise KeyboardInterrupt()
  previous_term=signal.signal(signal.SIGTERM,stop_watching)
  try:
    for source,command in commands:
      try:
        process=subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
        processes.append(process); sources[process.stdout]=source; selector.register(process.stdout,selectors.EVENT_READ)
      except OSError: pass
    last_emit=0.0; last_heartbeat=0.0
    print(json.dumps(watch_event_payload(),separators=(",",":")),flush=True)
    if not processes:
      print(json.dumps(watch_event_payload("heartbeat",True,"polling-only"),separators=(",",":")),flush=True)
      return False
    while processes:
      events=selector.select(timeout=15)
      for key,_mask in events:
        line=key.fileobj.readline()
        if not line:
          try: selector.unregister(key.fileobj)
          except (KeyError,ValueError): pass
          continue
        now=time.monotonic()
        lifecycle=None
        if sources.get(key.fileobj) in ("docker","podman"):
          try: lifecycle=normalize_container_event(sources[key.fileobj],json.loads(line),all_services(),DOCKER_ALIASES)
          except (TypeError,ValueError,json.JSONDecodeError): lifecycle=None
        if lifecycle or now-last_emit >= 1.0:
          print(json.dumps(watch_event_payload("changed",lifecycle=lifecycle),separators=(",",":")),flush=True); last_emit=now
      now=time.monotonic()
      if not events and now-last_heartbeat >= 15.0:
        print(json.dumps(watch_event_payload(),separators=(",",":")),flush=True); last_heartbeat=now
      processes=[process for process in processes if process.poll() is None]
  except KeyboardInterrupt: pass
  finally:
    for process in processes:
      try: process.terminate()
      except (OSError,ProcessLookupError): pass
    selector.close()
    signal.signal(signal.SIGTERM,previous_term)
  return True

def service_by_id(sid):
  return next((s for s in all_services() if s["id"]==sid),None)

def reset_discovery():
  SNAPSHOT.reset()

def verify_action(service, action, timeout=8.0, interval=0.25):
  if action not in CONTROL_ACTIONS: return
  deadline=time.monotonic()+max(0,float(timeout))
  state={"active":False,"hasError":False}
  while True:
    reset_discovery()
    state=INSPECTOR.inspect(service,True)
    satisfied=(not state["active"]) if action == "stop" else state["active"] and not state["hasError"]
    if satisfied: return
    if time.monotonic() >= deadline: break
    time.sleep(min(max(0.01,float(interval)),max(0,deadline-time.monotonic())))
  if action == "stop": raise RuntimeError(service["name"]+" is still running after the stop timeout")
  raise RuntimeError(service["name"]+" failed to become healthy before the start timeout; check its service or container logs")

def aur_environment(service):
  env=os.environ.copy()
  keys=AUR_SIGNING_KEYS.get(service["id"], ())
  if not keys: return env
  keyring=data_home()/"omarchy/p2p-services/aur-gnupg"
  ensure_private_directory(keyring,data_home())
  for fingerprint in keys:
    listed=subprocess.run([GPG,"--homedir",str(keyring),"--batch","--list-keys",fingerprint],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if listed.returncode != 0:
      fetched=subprocess.run([CURL,"--fail","--silent","--show-error","--location","--max-time","15","https://keys.openpgp.org/vks/v1/by-fingerprint/"+fingerprint],capture_output=True)
      if fetched.returncode != 0 or not fetched.stdout or len(fetched.stdout) > 1048576: raise RuntimeError("required AUR signing key could not be downloaded")
      subprocess.run([GPG,"--homedir",str(keyring),"--batch","--import"],input=fetched.stdout,check=True,stdout=subprocess.DEVNULL)
      listed=subprocess.run([GPG,"--homedir",str(keyring),"--batch","--list-keys",fingerprint],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
      if listed.returncode != 0: raise RuntimeError("required AUR signing key could not be verified")
  env["GNUPGHOME"]=str(keyring)
  return env


def install_service(service, auto_start=False):
  packages=PACKAGE_HINTS.get(service["id"],[])
  omarchy=shutil.which("omarchy")
  if not omarchy: raise RuntimeError("Omarchy package installer is unavailable")
  command=install_command(os.path.realpath(omarchy),service["id"],packages,AUR_INSTALL_IDS)
  install_env=aur_environment(service) if service["id"] in AUR_INSTALL_IDS else None
  subprocess.check_call(command, **({"env":install_env} if install_env else {}))
  reset_discovery()
  if not installed_packages(service,required=True,bypass=True): raise RuntimeError("package was not detected after installation")
  print("Completed stage: package installed",flush=True)
  if auto_start:
    try:
      reset_discovery()
      control(service,"start",terminal_auth=True)
      verify_action(service,"start")
      print("Completed stage: service started",flush=True)
    except Exception as error:
      raise RuntimeError("package installed, but automatic start failed: "+str(error)) from error

def installed_packages(service, required=False, bypass=False):
  """Return only exact, allowlisted package names from one package snapshot."""
  if SNAPSHOT.packages is None or bypass:
    SNAPSHOT.packages=package_snapshot(required=required,bypass=bypass)
  return [package for package in PACKAGE_HINTS.get(service["id"],[]) if package in SNAPSHOT.packages]

def uninstall_service(service, retention=10):
  packages=installed_packages(service,required=True,bypass=True)
  if not packages: raise RuntimeError("no removable allowlisted package is installed for this service")
  if INSPECTOR.inspect(service,True)["active"]: raise RuntimeError("stop the service before uninstalling it")
  omarchy=shutil.which("omarchy")
  if not omarchy: raise RuntimeError("Omarchy package remover is unavailable")
  backup=BACKUPS.backup(service,retention)
  if backup: print("Configuration backup: "+backup,flush=True)
  if INSPECTOR.inspect(service,True)["active"]:
    raise RuntimeError("service started while its configuration was being backed up; stop it and retry uninstall")
  subprocess.check_call(uninstall_command(os.path.realpath(omarchy),packages))
  reset_discovery()
  if installed_packages(service,required=True,bypass=True): raise RuntimeError("package is still installed after removal")
  print("Completed stage: package removed",flush=True)

def launch_command(service):
  command=command_path(service)
  if not command: return []

  if service["id"] == "aria2":
    return [command,"--conf-path="+os.path.expanduser(service["config"]),"--enable-rpc=true","--daemon=false","--rpc-listen-all=false"]
  return [command]

def privileged_call(args, terminal_auth=False):
  subprocess.check_call(([SUDO] if terminal_auth else [PKEXEC])+args)

def terminate_matching_process(pid, names, proc_root=pathlib.Path("/proc")):
  """Signal the process object only while its UID and executable identity still match."""
  pidfd = None
  try:
    if hasattr(os,"pidfd_open") and hasattr(signal,"pidfd_send_signal"): pidfd=os.pidfd_open(pid,0)
    process_root=pathlib.Path(proc_root)/str(pid)
    if process_root.stat().st_uid != os.getuid(): return False
    comm=process_root.joinpath("comm").read_text(errors="replace").strip()
    raw=process_root.joinpath("cmdline").read_bytes().split(b"\0",1)[0]
    argv0=os.path.basename(raw.decode("utf-8","replace")) if raw else ""
    if comm not in names and argv0 not in names: return False
    if pidfd is not None: signal.pidfd_send_signal(pidfd,signal.SIGTERM)
    else: os.kill(pid,signal.SIGTERM)
    return True
  except (OSError,ValueError): return False
  finally:
    if pidfd is not None: os.close(pidfd)

def matching_process_alive(pid, names, proc_root=pathlib.Path("/proc")):
  """Check whether an original PID still belongs to the expected current-user service."""
  try:
    process_root=pathlib.Path(proc_root)/str(pid)
    if process_root.stat().st_uid != os.getuid(): return False
    comm=process_root.joinpath("comm").read_text(errors="replace").strip()
    raw=process_root.joinpath("cmdline").read_bytes().split(b"\0",1)[0]
    argv0=os.path.basename(raw.decode("utf-8","replace")) if raw else ""
    return comm in names or argv0 in names
  except (OSError,ValueError): return False

def wait_for_process_exit(pids, names, timeout=3.0, interval=0.05):
  deadline=time.monotonic()+max(0,float(timeout))
  while any(matching_process_alive(pid,names) for pid in pids):
    remaining=deadline-time.monotonic()
    if remaining <= 0: raise RuntimeError("service processes are still stopping; try restart again")
    time.sleep(min(max(0.01,float(interval)),remaining))

def wait_for_path(path, timeout=5.0, interval=0.05):
  deadline=time.monotonic()+max(0,float(timeout))
  while not pathlib.Path(path).exists():
    remaining=deadline-time.monotonic()
    if remaining <= 0: raise RuntimeError("service configuration was not created after startup")
    time.sleep(min(max(0.01,float(interval)),remaining))

def prepare_service_start(service, system_unit, terminal_auth=False):
  if service["id"] != "amule" or not system_unit: return
  config="/var/lib/amule/.aMule/amule.conf"
  credential_dir=data_home()/"omarchy/p2p-services/credentials"
  ensure_private_directory(credential_dir,data_home())
  credential_file=credential_dir/"amule-ec-password"
  if not credential_file.exists() and not os.path.exists(config):
    privileged_call([SYSTEMCTL,"start",system_unit],terminal_auth)
    wait_for_path(config)
  password=read_or_create_secret(credential_file,lambda: secrets.token_urlsafe(24),base=data_home())
  digest=hashlib.md5(password.encode("utf-8"),usedforsecurity=False).hexdigest()
  web_edit=r"/^\[WebServer\]"+chr(36)+r"/,/^\[GUI\]$/{s/^Enabled=.*/Enabled=1/;s/^Password="+chr(36)+"/Password="+digest+"/;s/^Template="+chr(36)+"/Template=default/;}"
  privileged_call(["/usr/bin/sed", "-i", "-e", "s/^AcceptExternalConnections=.*/AcceptExternalConnections=1/", "-e", "s/^ECPassword="+chr(36)+"/ECPassword="+digest+"/", "-e", web_edit, config], terminal_auth)

def control(service, action, terminal_auth=False):
  if service.get("controllable") is False and action in CONTROL_ACTIONS.union({"config"}):
    raise RuntimeError("custom services are observation-only")
  docker_items=PROBE.docker_matches(service)
  user_unit,user_active=PROBE.unit_state(service["units"],True) if action in CONTROL_ACTIONS else ("",False)
  system_unit,system_active=PROBE.unit_state(service["units"],False) if action in CONTROL_ACTIONS else ("",False)
  if docker_items and action in CONTROL_ACTIONS:
    if user_active or system_active: raise RuntimeError("service has multiple control backends active")
    completed=[]
    for command in container_action_commands(docker_items,action):
      try: subprocess.check_call(command)
      except subprocess.CalledProcessError as error:
        error.completed_commands=list(completed)
        raise
      completed.append(command)
    return
  if action=="open":
    items=PROBE.docker_matches(service)
    routes=PROBE.proxy_candidates(items)
    target=safe_http_url((routes[0][1] if routes else "") or PROBE.published_url(service,items,"") or service["web"])
    if not target: raise RuntimeError("no valid console URL is available")
    subprocess.Popen([XDG_OPEN,target],start_new_session=True); return
  if action=="config":
    targets=config_targets(service,docker_items)
    if not targets: raise RuntimeError("configuration path does not exist yet")
    target=targets[0]
    if os.path.isdir(target): subprocess.Popen([XDG_OPEN,target],start_new_session=True); return
    if os.access(target,os.W_OK):
      launcher=shutil.which("omarchy-launch-config-editor")
      if not launcher: raise RuntimeError("Omarchy config editor is unavailable")
      subprocess.Popen([os.path.realpath(launcher),target],start_new_session=True); return
    editor=terminal_editor()
    editor_env=os.environ.copy()
    editor_env.update(SUDO_EDITOR=editor,VISUAL=editor,EDITOR=editor)
    subprocess.Popen(["omarchy-launch-terminal",SUDOEDIT,target],env=editor_env,start_new_session=True); return
  if action in CONTROL_ACTIONS:
    if user_active and system_active:
      raise RuntimeError("service has multiple systemd scopes active")
    if action=="start" and (user_active or system_active): return
    if user_active or (user_unit and not system_active):
      if (action == "start" and user_active) or (action == "stop" and not user_active): return
      subprocess.check_call(systemd_action_command(SYSTEMCTL,user_unit,True,action)); return
    if system_unit:
      if (action == "start" and system_active) or (action == "stop" and not system_active): return
      if action=="restart" and service["id"]=="amule":
        privileged_call([SYSTEMCTL,"stop",system_unit],terminal_auth)
        prepare_service_start(service,system_unit,terminal_auth)
        privileged_call([SYSTEMCTL,"start",system_unit],terminal_auth); return
      if action in ("start","restart"): prepare_service_start(service,system_unit,terminal_auth)
      privileged_call([SYSTEMCTL,action,system_unit],terminal_auth); return
    all_pids=PROBE.pids_for(service["processes"])
    pids=PROBE.pids_for(service["processes"], current_user_only=True)
    if action=="start" and all_pids: return
    if action in ("stop","restart") and set(all_pids)-set(pids):
      raise RuntimeError("service process is not owned by the current user")
    if action in ("stop","restart"):
      terminating=[pid for pid in pids if terminate_matching_process(pid,service["processes"])]
      if action=="stop": return
      wait_for_process_exit(terminating,service["processes"])
    command=launch_command(service)
    if command: subprocess.Popen(command,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True); return
  raise RuntimeError("unsupported action")

def status_snapshot(private=True, console_host="", traffic=True, all_containers=True, services=None):
  SNAPSHOT.all_containers=all_containers
  SNAPSHOT.services=all_services() if services is None else services
  selected=[service for service in SNAPSHOT.services if detected(service)]
  if traffic:
    matched=[item for service in selected for item in PROBE.docker_matches(service) if item.get("State",{}).get("Running")]
    unique={(item.get("_runtime"),str(item.get("Name","")).lstrip("/")):item for item in matched}
    PROBE.container_stats(list(unique.values()))
  else:
    SNAPSHOT.container_stats={}
  return [INSPECTOR.inspect(service,private,console_host) for service in selected]

def main():
  if len(sys.argv)<2: raise SystemExit(2)
  if sys.argv[1]=="settings-load" and len(sys.argv)==2:
    print(json.dumps(SETTINGS.load(),separators=(",",":"))); return
  if sys.argv[1]=="settings-watch" and len(sys.argv)==2:
    try: watch_settings(SETTINGS_FILE)
    except KeyboardInterrupt: pass
    return
  if sys.argv[1]=="settings-save" and len(sys.argv)==3:
    try: SETTINGS.save(sys.argv[2])
    except (OSError,ValueError,TypeError) as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="settings-patch" and len(sys.argv)==3:
    try: print(json.dumps(SETTINGS.patch(sys.argv[2]),separators=(",",":")))
    except (OSError,ValueError,TypeError) as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="settings-undo" and len(sys.argv)==2:
    try: print(json.dumps(SETTINGS.undo(),separators=(",",":")))
    except (OSError,ValueError,TypeError,RuntimeError) as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="settings-can-undo" and len(sys.argv)==2:
    raise SystemExit(0 if SETTINGS.can_undo() else 1)
  if sys.argv[1]=="events-list" and len(sys.argv)==2:
    print(json.dumps(EVENTS.load(),separators=(",",":"))); return
  if sys.argv[1]=="events-add" and len(sys.argv)==4:
    try: print(json.dumps(EVENTS.append(sys.argv[2],sys.argv[3]),separators=(",",":")))
    except (OSError,ValueError,TypeError) as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="events-clear" and len(sys.argv)==2:
    try: EVENTS.clear()
    except OSError as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="copy-support-report" and len(sys.argv) in (2,3):
    clipboard=shutil.which("wl-copy")
    if not clipboard: raise SystemExit("wl-copy is unavailable")
    settings=SETTINGS.load()
    snapshot={"services":status_snapshot(True,"",False,False,all_services(settings)),
              "diagnostics":list(SNAPSHOT.diagnostics),"durationMs":0}
    try: monitoring=json.loads(sys.argv[2]) if len(sys.argv)==3 and len(sys.argv[2]) <= 4096 else {}
    except (ValueError,TypeError): monitoring={}
    manifest=json.loads((pathlib.Path(__file__).parent/"manifest.json").read_text())
    subprocess.run([os.path.realpath(clipboard)],input=support_report_text(support_report(manifest,settings,snapshot,monitoring)),text=True,check=True)
    return
  if sys.argv[1]=="settings-reconcile" and len(sys.argv)==3:
    try:
      shell=json.loads(sys.argv[2]); durable=SETTINGS.load(); merged=reconcile_settings(shell,durable)
      if SETTINGS.last_recovery: print("Recovered settings; quarantined corrupt data at "+SETTINGS.last_recovery,file=sys.stderr)
      if merged != durable: merged=SETTINGS.save(json.dumps(merged))
      print(json.dumps(merged,separators=(",",":")))
    except (OSError,ValueError,TypeError) as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="settings-export" and len(sys.argv)==2:
    print(str(export_settings())); return
  if sys.argv[1]=="settings-import" and len(sys.argv)==2:
    target=data_home()/"omarchy/p2p-services/settings-export.json"
    try:
      raw=read_private_text(target,SETTINGS.MAX_PAYLOAD_BYTES); saved=SETTINGS.save(raw); print(json.dumps(saved,separators=(",",":")))
    except (OSError,ValueError,TypeError) as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="watch" and len(sys.argv)==2:
    if not watch_events(): raise SystemExit(3)
    return
  if sys.argv[1] in ("list","status"):
    started=time.monotonic()
    private=(len(sys.argv)<3 or sys.argv[2] != "unsafe")
    console_host=str(sys.argv[3]).strip() if len(sys.argv)>3 else ""
    traffic=(len(sys.argv)<5 or sys.argv[4] != "no-stats")
    all_containers=(len(sys.argv)<6 or sys.argv[5] != "running-containers")
    bypass=(len(sys.argv)>6 and sys.argv[6] == "bypass-cache")
    settings=SETTINGS.load()
    cache_key=json.dumps([private,console_host,traffic,all_containers,settings.get("customServices",[])],sort_keys=True,separators=(",",":"))
    def produce_status():
      services=all_services(settings)
      status=status_snapshot(private,console_host,traffic,all_containers,services)
      return {"services":status,"diagnostics":list(SNAPSHOT.diagnostics),"durationMs":round((time.monotonic()-started)*1000)}
    payload=cached_status(cache_key,produce_status,STATUS_CACHE_ROOT,bypass=bypass)
    if sys.argv[1]=="list": payload=payload["services"]
    print(json.dumps(payload,separators=(",",":"))); return
  if sys.argv[1]=="catalog":
    services=all_services(); SNAPSHOT.services=services
    print(json.dumps([dict(id=s["id"],name=s["name"],icon=s["icon"],category=s["category"],detected=detected(s),packages=PACKAGE_HINTS.get(s["id"],[]),installedPackages=installed_packages(s),backups=BACKUPS.records(s["id"])) for s in services],separators=(",",":"))); return
  if sys.argv[1]=="install" and len(sys.argv) in (3,4):
    service=service_by_id(sys.argv[2])
    if not service: raise SystemExit("unknown service")
    if service.get("custom"): raise SystemExit("custom services are observation-only")
    try: install_service(service,len(sys.argv)==4 and sys.argv[3]=="start")
    except subprocess.CalledProcessError as error: raise SystemExit(error.returncode)
    except Exception as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="uninstall" and len(sys.argv) in (3,4):
    service=service_by_id(sys.argv[2])
    if not service: raise SystemExit("unknown service")
    if service.get("custom"): raise SystemExit("custom services are observation-only")
    try: uninstall_service(service,int(sys.argv[3]) if len(sys.argv)==4 else 10)
    except subprocess.CalledProcessError as error: raise SystemExit(error.returncode)
    except Exception as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="restore-backup" and len(sys.argv)==4:
    service=service_by_id(sys.argv[2])
    if not service: raise SystemExit("unknown service")
    if service.get("custom"): raise SystemExit("custom services are observation-only")
    try:
      def require_stopped():
        if INSPECTOR.inspect(service,True)["active"]: raise RuntimeError("stop the service before restoring configuration")
      require_stopped()
      print(BACKUPS.restore(service,sys.argv[3],require_stopped))
    except Exception as error: print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  if sys.argv[1]=="open-url" and len(sys.argv)==3:
    url=safe_http_url(sys.argv[2])
    if not url: raise SystemExit("invalid console URL")
    subprocess.Popen([XDG_OPEN,url],start_new_session=True); return
  if sys.argv[1]=="copy-diagnostics" and len(sys.argv) in (3,4):
    service=service_by_id(sys.argv[2])
    if not service or not detected(service): raise SystemExit("service not detected")
    clipboard=shutil.which("wl-copy")
    if not clipboard: raise SystemExit("wl-copy is unavailable")
    private=len(sys.argv)<4 or sys.argv[3] != "unsafe"
    subprocess.run([os.path.realpath(clipboard)],input=INSPECTOR.diagnostics_text(service,private),text=True,check=True); return
  if sys.argv[1]=="logs" and len(sys.argv)==3:
    service=service_by_id(sys.argv[2])
    if not service or not detected(service): raise SystemExit("service not detected")
    raise SystemExit(show_logs(service))
  if sys.argv[1]=="action" and len(sys.argv)==4:
    service=service_by_id(sys.argv[2])
    if not service or not detected(service): raise SystemExit("service not detected")
    try: control(service,sys.argv[3]); verify_action(service,sys.argv[3])
    except subprocess.CalledProcessError as error:
      command=list(error.cmd) if isinstance(error.cmd,(list,tuple)) else [str(error.cmd)]
      backend=os.path.basename(str(command[0])) if command else "command"
      operation=str(command[1]) if len(command)>1 else sys.argv[3]
      message=backend+" "+operation+" failed with exit code "+str(error.returncode)
      completed=getattr(error,"completed_commands",[])
      if completed:
        labels=[os.path.basename(str(item[0]))+" "+str(item[1]) for item in completed if len(item)>1]
        if labels: message += "; "+", ".join(labels)+" already completed"
      print(message,file=sys.stderr)
      raise SystemExit(error.returncode)
    except Exception as error:
      print(str(error),file=sys.stderr); raise SystemExit(1)
    return
  raise SystemExit(2)
if __name__=="__main__": main()
