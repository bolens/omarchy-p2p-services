#!/usr/bin/env bash
set -euo pipefail
[[ $# -ge 2 && -d $1 ]] || { printf 'Usage: publish-screenshot-assets STAGE FILE...\n' >&2; exit 2; }
stage=$1; shift
backup=$(mktemp -d "${TMPDIR:-/tmp}/p2p-screenshot-publish.XXXXXX"); complete=false
rollback() {
  local status=$? relative
  if [[ $complete == false ]]; then
    for relative in "$@"; do
      if [[ -f $backup/$relative ]]; then install -m "$(stat -c '%a' "$backup/$relative")" "$backup/$relative" "$relative"
      elif [[ -f $backup/.absent/$relative ]]; then rm -f -- "$relative"
      fi
    done
    ((status == 0)) || printf 'Rolled back incomplete screenshot publication.\n' >&2
  fi
  rm -rf -- "$backup"; return "$status"
}
trap 'rollback "$@"' EXIT INT TERM
for relative in "$@"; do
  [[ $relative != /* && $relative != .. && $relative != ../* && $relative != */../* && $relative != */.. ]] \
    || { printf 'Unsafe screenshot publication path: %s\n' "$relative" >&2; exit 2; }
  [[ -f $stage/$relative ]] || { printf 'Missing staged screenshot publication file: %s\n' "$relative" >&2; exit 1; }
  if [[ -f $relative ]]; then
    mkdir -p "$backup/$(dirname "$relative")"; cp -- "$relative" "$backup/$relative"
  else
    mkdir -p "$backup/.absent/$(dirname "$relative")"; touch "$backup/.absent/$relative"
  fi
done
for relative in "$@"; do
  mkdir -p "$(dirname "$relative")"
  mode=0644; [[ -f $relative ]] && mode=$(stat -c '%a' "$relative")
  install -m "$mode" "$stage/$relative" "$relative"
  [[ ${P2P_CAPTURE_FAIL_AT:-} != "published:$relative" ]] || { printf 'Injected capture failure.\n' >&2; exit 1; }
done
complete=true
