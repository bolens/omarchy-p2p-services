#!/usr/bin/python3
"""Owned IPC fixture. No service commands, subprocesses, sleeps or networking."""
import json
import os
import stat
import sys
from pathlib import Path


def response(arguments):
    if arguments == ["events-list"]:
        return "[]"
    if len(arguments) == 2 and arguments[0] == "settings-reconcile":
        if len(arguments[1].encode()) > 65536:
            raise ValueError("oversized settings")
        value = json.loads(arguments[1])
        if not isinstance(value, dict):
            raise ValueError("settings must be an object")
        return json.dumps(value, separators=(",", ":"), ensure_ascii=False)
    raise ValueError("operation is not allowed")


def audit(operation, accepted):
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    info = runtime.lstat()
    if not runtime.is_absolute() or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("unowned runtime directory")
    path = runtime / "qml-ipc-helper-audit.jsonl"
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1 or info.st_mode & 0o077 or info.st_size > 16384:
            raise ValueError("unowned helper audit file")
        data = (json.dumps({"operation": operation, "accepted": accepted}, separators=(",", ":")) + "\n").encode()
        if os.write(descriptor, data) != len(data):
            raise ValueError("incomplete audit write")
    finally:
        os.close(descriptor)


def main(arguments):
    operation = arguments[0] if arguments else ""
    try:
        output = response(arguments)
    except (ValueError, TypeError):
        audit(operation, False)
        print("Invalid IPC fixture helper invocation", file=sys.stderr)
        return 64
    audit(operation, True)
    sys.stdout.write(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
