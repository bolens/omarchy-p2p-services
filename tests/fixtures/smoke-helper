#!/usr/bin/sh
case "$1" in
  settings-reconcile|settings-save|settings-patch)
    if [ "$#" -ge 2 ]; then printf '%s' "$2"; else printf '%s' '{}'; fi
    ;;
  status)
    printf '%s' '{"services":[],"diagnostics":[],"durationMs":1}'
    ;;
  catalog)
    sleep 0.4
    printf '%s' '[]'
    ;;
  watch)
    exit 0
    ;;
  *)
    exit 2
    ;;
esac
