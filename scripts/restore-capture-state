#!/usr/bin/env bash
set -euo pipefail
[[ $# == 1 && -d $1 ]] || { printf 'Usage: restore-capture-state RECOVERY_DIR\n' >&2; exit 2; }
recovery=$1
settings=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json
state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/p2p-services
[[ -f $recovery/shell.json ]] || { printf 'Recovery directory is incomplete.\n' >&2; exit 1; }
install -D -m 0600 "$recovery/shell.json" "$settings"
for name in settings.json settings.previous.json; do
  if [[ -f $recovery/$name ]]; then install -D -m 0600 "$recovery/$name" "$state/$name"; else rm -f -- "$state/$name"; fi
done
printf 'Restored P2P capture state from %s. Reload settings when safe.\n' "$recovery"
