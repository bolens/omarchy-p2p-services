HOME = pathlib.Path.home()

def xdg_directory(variable, fallback):
  configured = os.environ.get(variable, "").strip()
  candidate = pathlib.Path(configured) if configured else pathlib.Path(fallback)
  return candidate if candidate.is_absolute() else pathlib.Path(fallback)

STATE_HOME = xdg_directory("XDG_STATE_HOME", HOME/".local/state")
DATA_HOME = xdg_directory("XDG_DATA_HOME", HOME/".local/share")
STATE_ROOT = STATE_HOME/"omarchy/p2p-services"
SETTINGS_FILE = STATE_ROOT/"settings.json"
SETTINGS = SettingsStore(STATE_ROOT, SETTINGS_FILE, sanitize_settings)
EVENTS = EventStore(STATE_ROOT)
STATUS_CACHE_ROOT = xdg_directory("XDG_RUNTIME_DIR", "/run/user/"+str(os.getuid()))/"omarchy-p2p-services"
