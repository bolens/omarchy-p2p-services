#!/usr/bin/env bash
set -euo pipefail
[[ $# == 1 && -d $1 ]] || { printf 'Usage: capture-plugin-fingerprint PLUGIN_ROOT\n' >&2; exit 2; }
find "$1" -maxdepth 1 -type f \( -name '*.qml' -o -name '*.js' -o -name '*.py' -o -name 'p2p-control' -o -name 'manifest.json' \) \
  ! -name 'Runtime*Test.qml' -printf '%P\0' | sort -z | while IFS= read -r -d '' file; do
    printf '%s\0' "$file"; sha256sum "$1/$file"
  done | sha256sum | awk '{print $1}'
