#!/usr/bin/env bash
set -euo pipefail

qs_command=${P2P_QS_COMMAND:-qs}
command -v "$qs_command" >/dev/null || { printf 'Missing required command: %s\n' "$qs_command" >&2; exit 127; }
command -v jq >/dev/null || { printf 'Missing required command: jq\n' >&2; exit 127; }

shell_pid=""
while read -r candidate; do
  [[ $candidate =~ ^[1-9][0-9]*$ ]] || continue
  probe=$($qs_command ipc --pid "$candidate" call io.github.bolens.p2p-services settingsSnapshot 2>/dev/null || true)
  if jq -e '._p2pSettingsVersion == 1 and .id == "io.github.bolens.p2p-services"' <<<"$probe" >/dev/null 2>&1; then
    shell_pid=$candidate
    break
  fi
done < <($qs_command list --all | awk '/Process ID:/ { print $3 }')
[[ -n $shell_pid ]] || { printf 'No IPC-ready P2P Services shell found.\n' >&2; exit 1; }

call() { "$qs_command" ipc --pid "$shell_pid" call io.github.bolens.p2p-services "$@"; }
snapshot=$(call settingsSnapshot)
jq -e '._p2pSettingsVersion == 1 and (._p2pRevision | type == "number")
  and (.privacyFilter | type == "boolean") and (.serviceLayout | IN("list", "grid"))' \
  <<<"$snapshot" >/dev/null || { printf 'Invalid settings snapshot: %s\n' "$snapshot" >&2; exit 1; }
[[ $(call captureContract) == 2 ]] || { printf 'Unsupported capture IPC contract.\n' >&2; exit 1; }
[[ $(call settingsReady __invalid__) == false ]] || { printf 'Invalid settings page was accepted.\n' >&2; exit 1; }
printf 'P2P Services live read-only IPC verification passed for PID %s.\n' "$shell_pid"
