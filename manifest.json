{
  "schemaVersion": 1,
  "id": "io.github.bolens.p2p-services",
  "name": "P2P Services",
  "version": "0.3.6",
  "author": "bolens",
  "license": "MIT",
  "description": "Detect, inspect, and control local peer-to-peer and overlay-network services with privacy-aware connection details.",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {"service": "Service.qml", "barWidget": "BarWidget.qml"},
  "barWidget": {
    "displayName": "P2P Services",
    "description": "Status, connections, controls, and privacy filtering for detected P2P services.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "privacyFilter": true,
      "showStopped": true,
      "showCount": true,
      "refreshSeconds": 5,
      "backgroundRefreshSeconds": 15,
      "reconcileSeconds": 60,
      "widgetIcon": "󰒍",
      "showLoadingIndicators": true,
      "animateLoadingIndicators": true,
      "loadingIndicatorStyle": "spinner",
      "loadingIndicatorGlyph": ">",
      "loadingIndicatorSpeed": 140,
      "popupMaxHeight": 600,
      "consoleHost": "",
      "notifyOnControlChanges": true,
      "autoStartAfterInstall": false,
      "showTrafficStats": true,
      "compactCards": false,
      "serviceSortMode": "custom",
      "serviceSortDirection": "automatic",
      "favoritesFirst": true,
      "runningFirst": false,
      "stableLiveSort": true,
      "serviceGroupMode": "none",
      "serviceGroupDirection": "automatic",
      "groupCountMode": "active-total",
      "showGroupIcons": true,
      "savedViews": [],
      "serviceLayout": "list",
      "cardDensity": "comfortable",
      "showStatusRail": true,
      "showFavoriteMarker": true,
      "showBackendBadge": false,
      "showCardSummary": true,
      "showQuickActions": true,
      "showGroupCounts": true,
      "compactHeader": false,
      "groupHeaderStyle": "surfaced",
      "barPresentation": "active",
      "categoryIcons": {},
      "hideZeroCount": false,
      "barFontSize": 14,
      "barHorizontalMargin": 8,
      "barVerticalPadding": 6,
      "barFixedWidth": 0,
      "barTextRotation": "normal",
      "barForegroundColorRole": "foreground",
      "barActiveColorRole": "accent",
      "barDimWhenIdle": false,
      "popupWidth": 600,
      "runningColorRole": "accent",
      "stoppedColorRole": "muted",
      "errorColorRole": "urgent",
      "favoriteColorRole": "accent",
      "activityColorRole": "accent",
      "defaultView": "all",
      "defaultSavedView": "",
      "persistCollapsedGroups": true,
      "collapsedServiceGroups": {},
      "refreshOnOpen": true,
      "refreshAfterSettings": true,
      "refreshAfterActions": true,
      "staleWarningSeconds": 60,
      "notifyUnexpectedStops": false,
      "notifyRecovery": false,
      "notifyUnhealthy": true,
      "notifyRestartEvents": true,
      "enableEventJournal": false,
      "eventJournalLimit": 25,
      "notificationCooldownSeconds": 30,
      "restartWarningThreshold": 3,
      "trafficSmoothingSeconds": 3,
      "trafficMinimumBytesPerSecond": 1024,
      "favoriteServices": [],
      "serviceNotificationPolicies": {},
      "eventRefresh": true,
      "backupRetention": 10,
      "customServices": [],
      "enabledServices": [],
      "serviceLabels": {},
      "serviceIcons": {},
      "serviceShowStopped": {},
      "serviceConsoleUrls": {},
      "serviceOrder": []
    },
    "schema": [
      {"key":"privacyFilter","type":"boolean","label":"Privacy filter","description":"Redact peer endpoints, process IDs, node URLs, and configuration paths before they reach the UI.","defaultValue":true},
      {"key":"showStopped","type":"boolean","label":"Show stopped services","defaultValue":true},
      {"key":"showCount","type":"boolean","label":"Show active count in bar","defaultValue":true},
      {"key":"refreshSeconds","type":"integer","label":"Open-panel refresh interval","description":"Seconds between status updates while the popup is visible.","min":2,"max":60,"defaultValue":5},
      {"key":"backgroundRefreshSeconds","type":"integer","label":"Background refresh interval","description":"Seconds between status updates while the popup is closed.","min":15,"max":300,"defaultValue":15},
      {"key":"reconcileSeconds","type":"integer","label":"Container reconciliation interval","description":"Seconds between full scans that include stopped containers.","min":30,"max":600,"defaultValue":60},
      {"key":"widgetIcon","type":"string","label":"Bar icon","description":"Icon displayed in the bar for this widget.","defaultValue":"󰒍"},
      {"key":"showLoadingIndicators","type":"boolean","label":"Loading indicators","description":"Show terminal-style placeholders while service, catalog, and settings content is not ready.","defaultValue":true},
      {"key":"animateLoadingIndicators","type":"boolean","label":"Animate loading indicators","description":"Advance loading indicator frames. Disable this setting to reduce motion.","defaultValue":true},
      {"key":"loadingIndicatorStyle","type":"enum","label":"Loading indicator style","options":["spinner","dots","bar","glyph"],"defaultValue":"spinner"},
      {"key":"loadingIndicatorGlyph","type":"string","label":"Loading indicator glyph","description":"Static character used by the glyph loading style.","defaultValue":">"},
      {"key":"loadingIndicatorSpeed","type":"integer","label":"Loading animation interval","description":"Milliseconds between loading animation frames.","min":60,"max":1000,"defaultValue":140},
      {"key":"popupMaxHeight","type":"integer","label":"Popup maximum height","description":"Maximum popup height before its content scrolls.","min":360,"max":900,"defaultValue":600},
      {"key":"consoleHost","type":"string","label":"Global console host","description":"Host or IP used with Docker-published ports, such as server.home.arpa. Leave empty for automatic proxy discovery or 127.0.0.1.","defaultValue":""},
      {"key":"notifyOnControlChanges","type":"boolean","label":"Service action notifications","description":"Notify when start, stop, or restart succeeds, is cancelled, or fails.","defaultValue":true},
      {"key":"autoStartAfterInstall","type":"boolean","label":"Start services after install","description":"Start and verify package-managed services immediately after installation.","defaultValue":false},
      {"key":"showTrafficStats","type":"boolean","label":"Live transfer speeds","description":"Show aggregate live receive and transmit rates for active containers.","defaultValue":true},
      {"key":"compactCards","type":"boolean","label":"Compact service cards","defaultValue":false},
      {"key":"serviceSortMode","type":"enum","label":"Service sorting","options":["custom","name","category","status","activity","connections","uptime","traffic","backend","recent","errors"],"defaultValue":"custom"},
      {"key":"serviceSortDirection","type":"enum","label":"Sort direction","options":["automatic","ascending","descending"],"defaultValue":"automatic"},
      {"key":"favoritesFirst","type":"boolean","label":"Favorites first","defaultValue":true},
      {"key":"runningFirst","type":"boolean","label":"Running services first","defaultValue":false},
      {"key":"stableLiveSort","type":"boolean","label":"Stabilize live sorting","defaultValue":true},
      {"key":"serviceGroupMode","type":"enum","label":"Group services","options":["none","status","category","backend","scope","favorite"],"defaultValue":"none"},
      {"key":"serviceGroupDirection","type":"enum","label":"Group order","options":["automatic","ascending","descending"],"defaultValue":"automatic"},
      {"key":"groupCountMode","type":"enum","label":"Group counts","options":["active-total","active","total"],"defaultValue":"active-total"},
      {"key":"showGroupIcons","type":"boolean","label":"Show group icons","defaultValue":true},
      {"key":"savedViews","type":"object","label":"Saved views","description":"Named search, filter, sorting, and grouping presets managed inside the widget.","defaultValue":[]},
      {"key":"serviceLayout","type":"enum","label":"Service layout","options":["list","grid"],"defaultValue":"list"},
      {"key":"cardDensity","type":"enum","label":"Card density","options":["comfortable","compact","minimal"],"defaultValue":"comfortable"},
      {"key":"showStatusRail","type":"boolean","label":"Show status rail","defaultValue":true},
      {"key":"showFavoriteMarker","type":"boolean","label":"Show favorite marker","defaultValue":true},
      {"key":"showBackendBadge","type":"boolean","label":"Show backend badge","defaultValue":false},
      {"key":"showCardSummary","type":"boolean","label":"Show card summary","defaultValue":true},
      {"key":"showQuickActions","type":"boolean","label":"Show card quick actions","defaultValue":true},
      {"key":"showGroupCounts","type":"boolean","label":"Show group counts","defaultValue":true},
      {"key":"compactHeader","type":"boolean","label":"Compact header","defaultValue":false},
      {"key":"groupHeaderStyle","type":"enum","label":"Group header style","options":["surfaced","dense"],"defaultValue":"surfaced"},
      {"key":"barPresentation","type":"enum","label":"Bar presentation","options":["icon","active","active-total","health","category-active","category-active-total"],"defaultValue":"active"},
      {"key":"categoryIcons","type":"object","label":"Category icons","description":"Optional icon overrides used by category-count bar presentations.","defaultValue":{}},
      {"key":"hideZeroCount","type":"boolean","label":"Hide zero count","defaultValue":false},
      {"key":"barFontSize","type":"integer","label":"Bar font size","min":8,"max":28,"defaultValue":14},
      {"key":"barHorizontalMargin","type":"integer","label":"Bar horizontal margin","min":0,"max":24,"defaultValue":8},
      {"key":"barVerticalPadding","type":"integer","label":"Bar vertical padding","min":0,"max":16,"defaultValue":6},
      {"key":"barFixedWidth","type":"integer","label":"Bar fixed width","description":"Use zero for automatic width.","min":0,"max":240,"defaultValue":0},
      {"key":"barTextRotation","type":"enum","label":"Bar text rotation","options":["normal","clockwise","counterclockwise"],"defaultValue":"normal"},
      {"key":"barForegroundColorRole","type":"enum","label":"Bar idle color","options":["bar-active","urgent","accent","foreground","muted"],"defaultValue":"foreground"},
      {"key":"barActiveColorRole","type":"enum","label":"Bar active color","options":["bar-active","urgent","accent","foreground","muted"],"defaultValue":"accent"},
      {"key":"barDimWhenIdle","type":"boolean","label":"Dim bar while idle","defaultValue":false},
      {"key":"popupWidth","type":"integer","label":"Popup width","min":420,"max":800,"defaultValue":600},
      {"key":"runningColorRole","type":"enum","label":"Running color","options":["bar-active","urgent","accent","foreground","muted"],"defaultValue":"accent"},
      {"key":"stoppedColorRole","type":"enum","label":"Stopped color","options":["bar-active","urgent","accent","foreground","muted"],"defaultValue":"muted"},
      {"key":"errorColorRole","type":"enum","label":"Error color","options":["bar-active","urgent","accent","foreground","muted"],"defaultValue":"urgent"},
      {"key":"favoriteColorRole","type":"enum","label":"Favorite color","options":["bar-active","urgent","accent","foreground","muted"],"defaultValue":"accent"},
      {"key":"activityColorRole","type":"enum","label":"Activity color","options":["bar-active","urgent","accent","foreground","muted"],"defaultValue":"accent"},
      {"key":"defaultView","type":"enum","label":"Default panel view","options":["all","running","stopped","issues"],"defaultValue":"all"},
      {"key":"defaultSavedView","type":"string","label":"Default saved view","defaultValue":""},
      {"key":"persistCollapsedGroups","type":"boolean","label":"Remember collapsed groups","defaultValue":true},
      {"key":"collapsedServiceGroups","type":"object","label":"Collapsed groups","defaultValue":{}},
      {"key":"refreshOnOpen","type":"boolean","label":"Refresh when opened","defaultValue":true},
      {"key":"refreshAfterSettings","type":"boolean","label":"Refresh after settings changes","defaultValue":true},
      {"key":"refreshAfterActions","type":"boolean","label":"Refresh after service actions","defaultValue":true},
      {"key":"staleWarningSeconds","type":"integer","label":"Stale warning threshold","min":15,"max":600,"defaultValue":60},
      {"key":"notifyUnexpectedStops","type":"boolean","label":"Notify on unexpected stops","defaultValue":false},
      {"key":"notifyRecovery","type":"boolean","label":"Notify on recovery","defaultValue":false},
      {"key":"notifyUnhealthy","type":"boolean","label":"Notify on unhealthy services","defaultValue":true},
      {"key":"notifyRestartEvents","type":"boolean","label":"Notify on restart lifecycle","description":"Classify automatic restarts as updates, crashes, or unknown restarts before notifying.","defaultValue":true},
      {"key":"enableEventJournal","type":"boolean","label":"Local event journal","description":"Keep a bounded privacy-filtered history of service state and action outcomes.","defaultValue":false},
      {"key":"eventJournalLimit","type":"integer","label":"Visible journal entries","min":5,"max":100,"defaultValue":25},
      {"key":"notificationCooldownSeconds","type":"integer","label":"Notification cooldown","min":0,"max":300,"defaultValue":30},
      {"key":"restartWarningThreshold","type":"integer","label":"Unknown restart threshold","min":1,"max":100,"defaultValue":3},
      {"key":"trafficSmoothingSeconds","type":"integer","label":"Traffic smoothing window","min":1,"max":30,"defaultValue":3},
      {"key":"trafficMinimumBytesPerSecond","type":"integer","label":"Minimum visible traffic rate","min":0,"max":10485760,"defaultValue":1024},
      {"key":"eventRefresh","type":"boolean","label":"Event-assisted refresh","defaultValue":true},
      {"key":"backupRetention","type":"integer","label":"Configuration backups retained","min":1,"max":50,"defaultValue":10},
      {"key":"enabledServices","type":"string-list","label":"Service allowlist","description":"Leave empty to show every detected service; otherwise enter backend IDs such as yggdrasil, i2pd, freenet, airdcpp, ipfs.","defaultValue":[]}
    ]
  }
}
