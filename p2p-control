XDG_OPEN = "/usr/bin/xdg-open"
TERMINAL_EDITORS = ("nvim", "vim", "micro", "nano", "hx", "helix", "fresh")

def data_home():
  """Return the active XDG data directory; keeping this dynamic also aids isolation."""
  return xdg_directory("XDG_DATA_HOME", HOME/".local/share")

def terminal_editor():
  configured=os.environ.get("EDITOR", "").strip()
  candidates=([configured] if configured and not re.search(r"\s", configured) else []) + list(TERMINAL_EDITORS)
  for candidate in candidates:
    name=os.path.basename(candidate)
    if name not in TERMINAL_EDITORS: continue
    resolved=shutil.which(candidate)
    if resolved: return os.path.realpath(resolved)
  raise RuntimeError("no supported terminal editor is available")

def validate_service_registry(services):
  return validate_registry(services, PACKAGE_HINTS, DOCKER_ALIASES, AUR_INSTALL_IDS)

SERVICE_IDS=validate_service_registry(SERVICES)

def normalized_custom_services(raw):
  return normalize_custom_services(raw, SERVICE_IDS)

def all_services(settings=None):
  """Build one service registry from an optional command-scoped settings snapshot."""
  durable=SETTINGS.load() if settings is None else settings
  return SERVICES + normalized_custom_services(durable.get("customServices",[]))

def run(args, timeout=2):
  try: return subprocess.run(args, text=True, capture_output=True, timeout=timeout)
  except subprocess.TimeoutExpired:
    SNAPSHOT.warning("command_timeout",command=os.path.basename(str(args[0])),timeoutSeconds=timeout)
    return None
  except (OSError,ValueError) as error:
    SNAPSHOT.warning("command_failed",command=os.path.basename(str(args[0])),detail=type(error).__name__)
    return None

PROBE = RuntimeProbe(SNAPSHOT, lambda *args: run(*args), lambda: SNAPSHOT.services if SNAPSHOT.services is not None else all_services(), PS, SYSTEMCTL, DOCKER_ALIASES)

def command_path(service):
  candidates=[]
  for command in service["commands"]:
    found=shutil.which(command)
    if found: candidates.append(os.path.realpath(found))
  if service["id"] == "btfs":
    candidates += [str(HOME/".btfs/bin/btfs"),str(HOME/".local/bin/btfs")]
  for candidate in dict.fromkeys(candidates):
    if not os.path.isfile(candidate) or not os.access(candidate,os.X_OK): continue
    if service["id"] == "btfs":
      result=run([candidate,"version"],3)
      identity="" if not result else result.stdout+result.stderr
      if not result or result.returncode != 0 or not re.search(r"(?:go-)?btfs\s+version",identity,re.I): continue
    return candidate
  return ""

def detected(service):
  if SNAPSHOT.packages is None:
    SNAPSHOT.packages=package_snapshot()
  packaged=any(name in SNAPSHOT.packages for name in PACKAGE_HINTS.get(service["id"],[]))
  return packaged or bool(PROBE.docker_matches(service)) or bool(command_path(service)) or bool(PROBE.pids_for(service["processes"])) or any(PROBE.unit_state(service["units"], u)[0] for u in (True,False))

def package_database_generation():
  try: generation=pathlib.Path("/var/lib/pacman/local").stat().st_mtime_ns
  except OSError: generation=0
  return generation

def package_snapshot(required=False, bypass=False):
  """Reuse the expensive package inventory briefly; pacman database changes select a new key."""
  generation=package_database_generation()
  def produce():
    result=run([PACMAN,"-Qq"],5)
    available=bool(result and result.returncode == 0)
    return {"packages":result.stdout.split() if available else [],"available":available}
  payload=cached_status("packages:"+str(generation),produce,STATUS_CACHE_ROOT/"packages",ttl=15,bypass=bypass,max_entries=2)
  if required and payload.get("available") is not True: raise RuntimeError("package inventory is unavailable")
  return set(payload.get("packages",[]))

def socket_lines():
  if SNAPSHOT.socket_lines is None:
    result=run([SS,"-H","-tunap"],3)
    if not result or result.returncode != 0:
      SNAPSHOT.warning("socket_snapshot_unavailable")
      SNAPSHOT.socket_lines=[]
    else: SNAPSHOT.socket_lines=result.stdout.splitlines()
  return SNAPSHOT.socket_lines

def socket_index():
  """Index exact socket-owner PIDs once per discovery snapshot."""
  if SNAPSHOT.socket_by_pid is None:
    SNAPSHOT.socket_by_pid={}
    for line in socket_lines():
      for pid in set(re.findall(r"\bpid=(\d+)\b",line)):
        SNAPSHOT.socket_by_pid.setdefault(int(pid),[]).append(line)
  return SNAPSHOT.socket_by_pid

def sockets(pids, private):
  if not pids: return 0, 0, []
  indexed=socket_index(); lines=[]; seen=set()
  for pid in pids:
    for line in indexed.get(pid,[]):
      if line not in seen: lines.append(line); seen.add(line)
  listening=sum(1 for x in lines if "LISTEN" in x)
  connected=sum(1 for x in lines if "ESTAB" in x)
  endpoints=[]
  if not private:
    for line in lines:
      fields=line.split()
      if len(fields)>5: endpoints.append(fields[4]+" → "+fields[5])
    endpoints=sorted(endpoints)[:6]
  return connected,listening,endpoints

def config_targets(service, items=None):
  """Resolve editable host config paths, preferring Compose project files."""
  targets=[]
  matched = PROBE.docker_matches(service) if items is None else items
  for item in sorted(matched, key=lambda value: (value.get("_runtime", "docker"), str(value.get("Name", "")).lstrip("/"))):
    labels=(item.get("Config",{}).get("Labels") or {})
    workdir=labels.get("com.docker.compose.project.working_dir","")
    try:
      root=pathlib.Path(workdir).resolve(strict=True)
      if not root.is_dir(): continue
    except (OSError,ValueError): continue
    for value in labels.get("com.docker.compose.project.config_files","").split(","):
      if not value: continue
      try: path=pathlib.Path(value).resolve(strict=True)
      except (OSError,ValueError): continue
      if path.is_file() and (path.is_relative_to(root) or path.is_relative_to(HOME)) and path not in targets: targets.append(path)
  if targets: return [str(path) for path in targets]
  native=pathlib.Path(os.path.expanduser(service["config"]))
  return [str(native)] if native.exists() or native.is_symlink() or service.get("protectedConfig") else []

INSPECTOR = ServiceInspector(PROBE, SNAPSHOT, lambda *args: sockets(*args), lambda *args: config_targets(*args))

def show_logs(service):
  docker_items=sorted(PROBE.docker_matches(service),key=lambda item:(item.get("_runtime","docker"),str(item.get("Name","")).lstrip("/")))
  if docker_items:
    item=docker_items[0]; runtime=item.get("_runtime_cmd") or shutil.which(item.get("_runtime","docker")); name=str(item.get("Name","")).lstrip("/")
    if runtime and name: return subprocess.call([runtime,"logs","--tail","200","-f",name])
  user_unit,_=PROBE.unit_state(service["units"],True); system_unit,_=PROBE.unit_state(service["units"],False)
  if user_unit: return subprocess.call([SYSTEMCTL.replace("systemctl","journalctl"),"--user","-u",user_unit,"-n","200","-f"])
  if system_unit: return subprocess.call([SYSTEMCTL.replace("systemctl","journalctl"),"-u",system_unit,"-n","200","-f"])
  raise RuntimeError("no systemd or container log source is available")

